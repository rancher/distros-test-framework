#!groovy

node {
  def branch = "main"
  def test_dir = "${env.TEST_DIRECTORY_LIST}".split(',')

  if ("${env.BRANCH}" != "null" && "${env.BRANCH}" != "") {
    branch = "${env.BRANCH}"
  }

  def repo = scm.userRemoteConfigs
  if ("${env.REPO}" != "null" && "${env.REPO}" != "") {
    repo = [
      [url: "${env.REPO}"]
    ]
  }
  def timeout = "60m"
  if ("${env.TIMEOUT}" != "null" && "${env.TIMEOUT}" != "") {
    timeout = "${env.TIMEOUT}"
  }
  wrap([$class: 'AnsiColorBuildWrapper', 'colorMapName': 'XTerm', 'defaultFg': 2, 'defaultBg': 1]) {
    withFolderProperties {
      paramsMap = []
      params.each {
        if (it.value && it.value.trim() != "") {
          paramsMap << "$it.key=$it.value"
        }
      }
      withEnv(paramsMap) {
        stage('Checkout') {
          deleteDir()
          checkout([
            $class: 'GitSCM',
            branches: [
              [name: "*/${branch}"]
            ],
            extensions: scm.extensions + [
              [$class: 'CleanCheckout']
            ],
            userRemoteConfigs: repo
          ])
        }
        dir("./") {
          stage('Run Parallel Jobs') {
            echo "Running ${test_dir.size()} tests: ${test_dir}"
            def jobs = [:]

            test_dir.each { test_name ->
              // "<test>_qainfra" entries target the "<job>_qainfra" clone jobs; the
              // base name drives TEST_DIRECTORY and the job map lookup.
              def is_qainfra = test_name.endsWith("_qainfra")
              def base_name = is_qainfra ? test_name.substring(0, test_name.length() - 8) : test_name
              def actual_testdir_name = base_name
              def job_aws_ssh_key_name = "${AWS_SSH_KEY_NAME}"

              if (base_name == "docker_cri" || base_name.contains("validatecluster")) {
                actual_testdir_name = "validatecluster"
              }

              if (base_name.contains("restartservice")) {
                actual_testdir_name = "restartservice"
              }

              if (base_name.contains("mixedoscluster")) {
                actual_testdir_name = "mixedoscluster"
              }

              if (base_name.contains("killalluninstall")) {
                actual_testdir_name = "killalluninstall"
              }

              def install_params = [
                string(name: 'TEST_ARGS', value: "${TEST_ARGS}"),
                string(name: 'REPO', value: "${REPO}"), 
                string(name: 'BRANCH', value: "${branch}"),                                         
                string(name: 'PRODUCT_NAME', value: "${PRODUCT_NAME}"),                    
                string(name: 'INSTALL_VERSION', value: "${INSTALL_VERSION}"),
                string(name: 'INSTALL_MODE', value: "${INSTALL_MODE}"),
                string(name: 'INSTALL_CHANNEL', value: "${INSTALL_CHANNEL}"),              
                string(name: 'HOSTNAME_PREFIX', value: "${HOSTNAME_PREFIX}"), 
                string(name: 'TEST_DIRECTORY', value: actual_testdir_name),
                string(name: 'AWS_SSH_KEY_NAME', value: job_aws_ssh_key_name),
                string(name: 'REPORT_TO_QASE', value: "${REPORT_TO_QASE}"),
                string(name: 'QASE_PROJECT_ID', value: "${QASE_PROJECT_ID}"),
                string(name: 'QASE_RUN_ID', value: "${QASE_RUN_ID}"),
              ]

              // Legacy jobs still support the old selectable-key interface. Qainfra
              // children resolve their dedicated PEM directly from Jenkins Credentials.
              if (!is_qainfra && env.AWS_SSH_PEM_KEY?.trim()) {
                install_params << string(name: 'AWS_SSH_PEM_KEY', value: env.AWS_SSH_PEM_KEY)
              }

              // qainfra children: forward the qa-infra-automation ref when the batch sets one.
              if (is_qainfra && "${env.QA_INFRA_REF}" != "null" && "${env.QA_INFRA_REF}" != "") {
                install_params << string(name: 'QA_INFRA_REF', value: "${env.QA_INFRA_REF}")
              }

              def product_name = "${env.PRODUCT_NAME}"
              def suffix = (product_name == "rke2") ? "_rpm" : ""
              def testToJobMap = [
                "docker_cri": "k3s_docker_cri",
                "dualstack": "${product_name}_dual_stack",
                "ipv6only": "${product_name}_ipv6_only",
                "clusterrestore": "${product_name}_cluster_restore",
                "validatecluster": "${product_name}_validate_cluster",
                "validatecluster_arm": "${product_name}_validate_cluster_arm",
                "validatecluster_rpm": "rke2_validate_cluster_rpm",
                "validatecluster_arm_rpm": "rke2_validate_cluster_arm_rpm",
                "mixedoscluster": "rke2_windows_agent_rpm",
                "mixedoscluster_flannel": "rke2_windows_agent_flannel_rpm",
                "killalluninstall": "${product_name}_kill_all_uninstall${suffix}",
                "killalluninstall_arm": "${product_name}_kill_all_uninstall_arm${suffix}",
                "restartservice": "${product_name}_restart_service${suffix}",
                "restartservice_splitroles": "${product_name}_restart_service_splitroles${suffix}",
                "rebootinstances": "${product_name}_reboot_instances${suffix}",
                "certrotate": "${product_name}_cert_rotate${suffix}",
                "secretsencrypt": "${product_name}_secrets_encryption${suffix}",
                "clusterreset": "${product_name}_cluster_reset${suffix}"
              ]

              def jobName = testToJobMap[base_name]
              if (is_qainfra && jobName) {
                // clone jobs are named "<base job>_qainfra" and have no _rpm variants
                jobName = jobName.replace("_rpm", "") + "_qainfra"
              }

              if (jobName) {
                jobs[test_name] = { build job: jobName, parameters: install_params }
              }
            } // for each test_dir loop

            parallel jobs
          } // stage run parallel jobs
        } // dir
      } // withEnv
    } // withFolderProperties
  } // wrap
} // node

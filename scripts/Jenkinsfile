#!groovy

node {
  def job_name = "${JOB_NAME}"
  if (job_name.contains('/')) {
    job_names = job_name.split('/')
    job_name = job_names[job_names.size() - 1]
  }

  def testContainer = "${job_name}${env.BUILD_NUMBER}_test"
  def imageName = "acceptance-tests-${job_name}${env.BUILD_NUMBER}"
  def envFile = ".env"
  def qaseEnvFile = ".qase.env"
  def branch = "main"
  if (env.BRANCH && env.BRANCH != "null") {
    branch = env.BRANCH
  }

  def repo = scm.userRemoteConfigs
  if (env.REPO && env.REPO != "null") {
    repo = [[url: env.REPO]]
  }
  def timeout = "60m"
  if (env.TIMEOUT && env.TIMEOUT != "null") {
    timeout = env.TIMEOUT
  }

  def module = ""
  if (env.MODULE && env.MODULE != "null") {
    module = env.MODULE
  }

  wrap([$class: 'AnsiColorBuildWrapper', 'colorMapName': 'XTerm', 'defaultFg': 2, 'defaultBg': 1]) {
    withFolderProperties {
      def rawParamsMap = params.findAll { it.value?.trim() }
        .collectEntries { [(it.key): it.value] }
      def provisionerModule = rawParamsMap.PROVISIONER_MODULE ?: env.PROVISIONER_MODULE ?: 'legacy'
      // Qainfra private key material comes exclusively from Jenkins Credentials.
      // Legacy retains its selectable-key parameter until its additional keys have
      // dedicated credential IDs and can be migrated without breaking old jobs.
      def paramsMap = rawParamsMap.findAll {
        provisionerModule != 'qainfra' || it.key != 'AWS_SSH_PEM_KEY'
      }
      def sshPemCredentialId = provisionerModule == 'qainfra' ?
        'AWS_SSH_PEM_KEY_QAINFRA' : 'AWS_SSH_PEM_KEY'
      withEnv(paramsMap.collect { k, v -> "$k=$v" }) {
        // Bind credentials after parameters; qainfra always consumes this managed value.
        withCredentials([
          string(credentialsId: 'AWS_ACCESS_KEY_ID', variable: 'AWS_ACCESS_KEY_ID'),
          string(credentialsId: 'AWS_SECRET_ACCESS_KEY', variable: 'AWS_SECRET_ACCESS_KEY'),
          string(credentialsId: sshPemCredentialId, variable: 'JENKINS_SSH_PEM_KEY'),
          string(credentialsId: 'ADMIN_PASSWORD', variable: 'ADMIN_PASSWORD'),
          string(credentialsId: 'RKE2_RHEL_PASSWORD', variable: 'RKE2_RHEL_PASSWORD'),
          string(credentialsId: 'QASE_AUTOMATION_TOKEN', variable: 'QASE_AUTOMATION_TOKEN'),
        ]) {
          stage('Checkout') {
            deleteDir()
            checkout([
              $class: 'GitSCM',
              branches: [[name: "*/${branch}"]],
              extensions: scm.extensions + [[$class: 'CleanCheckout']],
              userRemoteConfigs: repo
            ])
          }
          stage('Create QASE Environment Variables') {
            script {
              def qase = 'REPORT_TO_QASE=' + env.REPORT_TO_QASE + '\n' +
                             'QASE_PROJECT_ID=' + env.QASE_PROJECT_ID + '\n' +
                             'QASE_RUN_ID=' + env.QASE_RUN_ID + '\n' +
                             'QASE_TEST_CASE_ID=' + env.QASE_TEST_CASE_ID + '\n' +
                             'QASE_AUTOMATION_TOKEN=' + env.QASE_AUTOMATION_TOKEN + '\n'
                writeFile file: qaseEnvFile, text: qase
                sh "chmod 600 ${qaseEnvFile}"
            }
          }
          dir('./') {
            try {
              stage('Configure and Build') {
                def sshPemKey = provisionerModule == 'qainfra' ?
                  env.JENKINS_SSH_PEM_KEY : (env.AWS_SSH_PEM_KEY ?: env.JENKINS_SSH_PEM_KEY)
                if (sshPemKey && env.AWS_SSH_KEY_NAME) {
                  dir('./config/.ssh') {
                    def decoded = new String(sshPemKey.decodeBase64())
                    writeFile file: 'aws_key.pem', text: decoded
                    sh 'chmod 600 aws_key.pem'
                  }
                }
                dir('./config') {
                  //update info in .env file
                  def data = "ENV_PRODUCT=${env.PRODUCT_NAME}\nENV_TFVARS=${env.PRODUCT_NAME}.tfvars\n" +
                  "KUBE_CONFIG=${env.KUBE_CONFIG}\nBASTION_IP=${env.BASTION_IP}\nLOG_LEVEL=${env.LOG_LEVEL}\nINSTALL_VERSION=${env.INSTALL_VERSION}\n" +
                   "ENV_MODULE=${module}\nINSTALL_CHANNEL=${env.INSTALL_CHANNEL}\n"

                  // qainfra provisioning contract. Default stays legacy during the canary
                  // phase — only jobs that set PROVISIONER_MODULE=qainfra opt in.
                  data += "PROVISIONER_MODULE=${provisionerModule}\n" +
                          "QA_INFRA_PROVIDER=${env.QA_INFRA_PROVIDER ?: 'aws'}\n" +
                          "PROVISIONER_TYPE=${env.PROVISIONER_TYPE ?: 'opentofu'}\n" +
                          "INFRA_PROVISIONER=${env.INFRA_PROVISIONER ?: 'opentofu'}\n" +
                          "RESOURCE_NAME=${env.HOSTNAME_PREFIX}\n" +
                          'SSH_LOCAL_KEY_PATH=/go/src/github.com/rancher/distros-test-framework/config/.ssh/aws_key.pem\n'
                  if (env.AWS_SSH_KEY_NAME) {
                    data += "SSH_KEY_NAME=${env.AWS_SSH_KEY_NAME}\n"
                  }

                  // qainfra mode keeps the legacy UX: the TFVARS text area (in qainfra format)
                  // replaces infrastructure/qainfra/vars.tfvars wholesale, guarded by a format marker.
                  def isQainfraBlob = env.TFVARS && (env.TFVARS =~ /(?m)^\s*(aws_hostname_prefix|aws_region|nodes)\s*=/)
                  if (provisionerModule == 'qainfra' && isQainfraBlob) {
                    writeFile(file: '../infrastructure/qainfra/vars.tfvars', text: env.TFVARS)
                  }
                  // server/worker flags are env-consumed by the framework — lift them out of the
                  // blob when no explicit param was given.
                  def flagFrom = { key ->
                    def m = (env.TFVARS ?: '') =~ /(?m)^\s*${key}\s*=\s*"(.*)"/
                    m.find() ? m.group(1) : ''
                  }
                  def serverFlags = env.SERVER_FLAGS ?: flagFrom('server_flags')
                  def workerFlags = env.WORKER_FLAGS ?: flagFrom('worker_flags')
                  if (serverFlags) { data += "SERVER_FLAGS=${serverFlags}\n" }
                  if (workerFlags) { data += "WORKER_FLAGS=${workerFlags}\n" }

                  ['QA_INFRA_REF', 'SSH_USER', 'NO_OF_SERVER_NODES', 'NO_OF_WORKER_NODES',
                   'SPLIT_ROLES', 'ETCD_ONLY_NODES', 'ETCD_CP_NODES', 'ETCD_WORKER_NODES',
                   'CP_ONLY_NODES', 'CP_WORKER_NODES', 'NODE_OS', 'AWS_AMI', 'ARCH', 'CNI',
                   'INSTANCE_TYPE', 'VOLUME_SIZE', 'VOLUME_TYPE',
                   'AWS_REGION', 'DATASTORE_TYPE', 'EXTERNAL_DB', 'EXTERNAL_DB_VERSION',
                   'DB_GROUP_NAME', 'EXTERNAL_DB_NODE_TYPE', 'EXTERNAL_DB_ENDPOINT',
                   'EXTERNAL_DB_SUBNET_IDS', 'DB_USERNAME', 'DB_PASSWORD', 'ENGINE_MODE',
                   'CREATE_EIP', 'OPTIONAL_FILES', 'INSTALL_METHOD'].each { name ->
                    def value = env."${name}"
                    if (value?.trim()) {
                      data += "${name}=${value}\n"
                    }
                  }

                  // Batch OS validation overrides map onto the qainfra contract too.
                  // Written last so they win over any whitelist value above.
                  [['BATCH_OS_AWS_AMI', 'AWS_AMI'], ['BATCH_OS_AWS_USER', 'SSH_USER'],
                   ['BATCH_OS_NODE_OS', 'NODE_OS']].each { src, dst ->
                    def value = env."${src}"
                    if (value?.trim() && value != 'null') {
                      data += "${dst}=${value}\n"
                    }
                  }

                    //adding data to .env file
                    writeFile(file: envFile, text: data)
                    sh "chmod 600 ${envFile}"

                  //update tfvars file
                  def version_param_name = "${env.PRODUCT_NAME}_version"
                  def channel_param_name = "${env.PRODUCT_NAME}_channel"
                  def filename = "${env.PRODUCT_NAME}.tfvars"
                  def configContents = env.TFVARS
                  def tfvarsContent = configContents +
                       "\n${version_param_name} = \"${INSTALL_VERSION}\"" +
                       "\n${channel_param_name} = \"${INSTALL_CHANNEL}\"" +
                       "\ninstall_mode = \"${INSTALL_MODE}\"" +
                       '\npassword = \"' + RKE2_RHEL_PASSWORD + '\"' +
                       '\nkey_name = \"' + AWS_SSH_KEY_NAME + '\"' +
                       '\naccess_key = \"/go/src/github.com/rancher/distros-test-framework/config/.ssh/aws_key.pem\"' +
                       '\nresource_name = \"' + HOSTNAME_PREFIX + '\"' +
                       "\nproduct = \"${env.PRODUCT_NAME}\""

                  // Override AMI, AWS user and node_os when triggered from batch OS validation
                  if (env.BATCH_OS_AWS_AMI && env.BATCH_OS_AWS_AMI != "null") {
                    tfvarsContent = tfvarsContent.replaceAll(/(?m)^aws_ami\s*=.*$\n?/, '')
                    tfvarsContent += "\naws_ami = \"${env.BATCH_OS_AWS_AMI}\""
                  }
                  if (env.BATCH_OS_AWS_USER && env.BATCH_OS_AWS_USER != "null") {
                    tfvarsContent = tfvarsContent.replaceAll(/(?m)^aws_user\s*=.*$\n?/, '')
                    tfvarsContent += "\naws_user = \"${env.BATCH_OS_AWS_USER}\""
                  }
                  if (env.BATCH_OS_NODE_OS && env.BATCH_OS_NODE_OS != "null") {
                    tfvarsContent = tfvarsContent.replaceAll(/(?m)^node_os\s*=.*$\n?/, '')
                    tfvarsContent += "\nnode_os = \"${env.BATCH_OS_NODE_OS}\""
                  }

                  writeFile file: filename, text: tfvarsContent
                  sh "chmod 600 ${filename}"
                  def testdata = readFile(file: filename)
                  println('\n\nTFVARS TEST DATA (secrets redacted)')
                  println(testdata.replaceAll(/(?i)(password|secret|token|pem)\s*=\s*"[^"]*"/, '$1 = "<REDACTED>"'))
                }
                stage('Docker Build') {
                  sh './scripts/configure.sh'
                  sh './scripts/build.sh'
                }
              }
              stage('Run TestCombination') {
                    sh """
                    docker run --name ${testContainer} -t \
                        --env-file ${envFile} \
                        --env-file ./config/.env \
                        --env-file ${qaseEnvFile} \
                        -e TEST_ARGS='${env.TEST_ARGS}' \
                        ${imageName} sh -c "chmod 400 /go/src/github.com/rancher/distros-test-framework/config/.ssh/aws_key.pem && \
                         cd ./entrypoint &&  go test -timeout=${timeout} -v  ./${env.TEST_DIRECTORY}/...  ${env.TEST_ARGS.replace('\"', '\\\"')}"
                    """
              }
            } finally {
              stage('Cleanup') {
                sh "docker stop ${testContainer} || true"
                sh "docker rm -v ${testContainer} || true"
                sh "docker rmi -f ${imageName} || true"
                sh "rm -f ${qaseEnvFile} || true"
                sh 'rm -f config/.ssh/aws_key.pem || true'
              } // stage
            } // finally
          } // dir
        } // withCredentials
      } // withEnv
    } // withFolderProperties
  } // wrap
} // node

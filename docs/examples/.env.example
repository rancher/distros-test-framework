# config/.env example for distros-test-framework.
# Uppercase names are what the framework and scripts/Jenkinsfile read; on the
# qainfra provisioner every `key = "value"` line of infrastructure/qainfra/vars.tfvars
# is exported too, so lowercase keys such as install_method also work as a fallback.

##################  REQUIRED  ##################

# k3s or rke2
ENV_PRODUCT=rke2

# Go package under entrypoint/ and, for packages with several suites, the build tag.
# Used by the Makefile targets (make test-run, test-suite ...).
TEST_DIR=upgradecluster
TEST_TAG=upgrademanual

# Baseline install
INSTALL_VERSION=v1.35.0+rke2r1
INSTALL_MODE=INSTALL_RKE2_VERSION          # INSTALL_RKE2_VERSION | INSTALL_RKE2_COMMIT (k3s: INSTALL_K3S_*)
INSTALL_CHANNEL=testing                    # testing | latest | stable

# rke2 only: rpm | tar. Blank = installer default (rpm on RHEL and SLES 16, tar elsewhere).
# Same value the Jenkins jobs expose as the INSTALL_METHOD parameter.
INSTALL_METHOD=

# \n-separated rke2/k3s config keys written to /etc/rancher/<product>/config.yaml
SERVER_FLAGS="write-kubeconfig-mode: 644\nselinux: true\nprofile: cis"
WORKER_FLAGS="selinux: true\nprofile: cis"

# Node OS label and matching SSH user for the AMI (ubuntu, rhel9, rhel10, sles15, sles16, slemicro ...)
NODE_OS=rhel10
SSH_USER=ec2-user
ARCH=amd64                                 # amd64 | arm64

# SSH key: host path to the private key and the AWS key-pair name it belongs to
SSH_LOCAL_KEY_PATH="/path/to/private/aws_key.pem"
SSH_KEY_NAME=my-aws-key-pair

# Unique prefix for every AWS resource of this run (lowercase, no hyphen; keep it short,
# node names are dsf-<prefix>-<product>-<hash>: max 10 chars for k3s, 9 for rke2)
RESOURCE_NAME=myprefix

##################  PROVISIONER (qainfra)  ##################

PROVISIONER_MODULE=qainfra                 # qainfra | legacy
QA_INFRA_PROVIDER=aws                      # only aws today
PROVISIONER_TYPE=opentofu
QA_INFRA_REF=main                          # rancher/qa-infra-automation branch or tag (not a SHA)
ENV_MODULE=                                # blank, or airgap for the airgap suite (see docs/testing.md)

# Topology comes from the nodes[] block in vars.tfvars. To build it from counts instead:
SPLIT_ROLES=false
NO_OF_SERVER_NODES=3                       # all-roles servers
NO_OF_WORKER_NODES=1
# ETCD_ONLY_NODES=3
# ETCD_CP_NODES=0
# ETCD_WORKER_NODES=0
# CP_ONLY_NODES=2
# CP_WORKER_NODES=0

# Legacy provisioner only: tfvars file under config/
# ENV_TFVARS=rke2.tfvars

##################  OPTIONAL  ##################

CNI=                                       # rke2 only: canal | calico | cilium | flannel | multus,<cni>
# dest,url pairs dropped on the nodes before the product starts (e.g. PSA config)
# OPTIONAL_FILES=/etc/rancher/rke2/custom-psa.yaml,https://example.com/pod_security_config.yaml
# CREATE_EIP=true                          # reboot/stop-start suites: keep node IPs
# NVIDIA_VERSION=580.95.05                 # nvidia suite

# Datastore: etcd (default) or an external DB provisioned by qa-infra
DATASTORE_TYPE=etcd
# EXTERNAL_DB=postgres                     # postgres | mysql | aurora-mysql ...
# EXTERNAL_DB_VERSION=18.3
# DB_GROUP_NAME=default.postgres18
# EXTERNAL_DB_NODE_TYPE=db.t3.medium
# DB_USERNAME=adminuser
# DB_PASSWORD=
# ENGINE_MODE=provisioned
# EXTERNAL_DB_ENDPOINT=                    # bring your own endpoint instead of provisioning

##################  UPGRADE / VERSION BUMP SUITES  ##################

UPGRADE_CHANNEL=testing
SUC_UPGRADE_VERSION=v1.36.1+rke2r1         # upgradesuc
INSTALL_VERSION_OR_COMMIT=v1.36.1+rke2r1   # upgrademanual / upgradereplacement
CHANNEL=stable                             # channel flag passed by the Makefile to the upgrade suites
DESTROY=false                              # true tears the cluster down after the test

# versionbump
# CMD=sudo journalctl -u k3s | grep 'etcd-version' | awk -F'"' '{ for(i=1; i<=NF; ++i) if($i == "etcd-version") print $(i+2) }', k3s -v
# EXPECTED_VALUE=3.5.7,v1.27
# VALUE_UPGRADED=3.5.9,v1.28.2
# TEST_CASE=
# WORKLOAD_NAME=
# DESCRIPTION=Test etcd version bump
# APPLY_WORKLOAD=
# DELETE_WORKLOAD=

##################  RUNNER  ##################

LOG_LEVEL=debug                            # "" (info) | info | debug | warn
IMG_NAME=test                              # scripts/docker_run.sh container name suffix
TAG_NAME=                                  # scripts/docker_run.sh image tag, default distros-test

# Qase reporting is read from config/.qase.env (see docs/examples/.qase.env)

# /etc/releasebot/releasebot.env: root:root 0600. systemd reads it before switching to the
# releasebot user, which cannot read the file itself.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
RELEASEBOT_CHANNELS=C07Q8H55F6Z
# Channels where anyone may start runs (e.g. the QA channel once the Slack scopes allow it).
RELEASEBOT_OPEN_CHANNELS=
RELEASEBOT_ALLOWED_USERS=U04M1C0BZAA
# true: requests only get the plan; false: they start at once (needs the credentials below).
RELEASEBOT_DRY_RUN=true

# Dry-run needs only the values above; add these (least privilege) for real runs only.
#GITHUB_TOKEN=
#QASE_AUTOMATION_TOKEN=
#JENKINS_MOWER_AUTH=

# DTF branch the workflow and jobs run from (the matrix's dtfRef, qa-infra-RC-1 until it merges).
#RELEASEBOT_DTF_REF=main
